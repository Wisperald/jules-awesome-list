<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis="0": no periodic wake-ups. Time and date are TextClock views that the
  launcher redraws itself; the app only pushes updates when its own settings/alarms change.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_compact_description"
    android:initialLayout="@layout/widget_compact"
    android:previewLayout="@layout/widget_compact"
    android:previewImage="@drawable/ic_launcher_legacy"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
