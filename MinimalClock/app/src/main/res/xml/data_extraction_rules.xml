<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing is uploaded to cloud backup (the app keeps all data on the device).
  Device-to-device transfer (cable / local Wi-Fi when moving to a new phone) keeps the
  alarms, timers, world clock and settings, including device-protected storage.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="device_file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
